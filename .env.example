# ==============================================================================
# JanSetu AI — Unified Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database & Authentication)
# ------------------------------------------------------------------------------
# Project URL from Supabase Settings -> API
SUPABASE_URL=https://lrrwhqoeopwiwjthlpdb.supabase.co

# Public anon key (safe for browser & frontend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret service role key (keep secure, only for backend / worker)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Frontend (React 18 + Vite)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://lrrwhqoeopwiwjthlpdb.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional if using custom remote domains. Defaults to relative /api/v1 & /ai-api/api/v1
# VITE_API_BASE_URL=https://jansetu-backend.onrender.com/api/v1
# VITE_AI_SERVICE_URL=https://jansetu-ai-service.onrender.com/api/v1

# ------------------------------------------------------------------------------
# 3. NestJS Backend API Gateway
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
# Comma-separated allowed frontend domains for CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://jansetu.vercel.app
# FastAPI microservice endpoint
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. FastAPI AI Microservice (Python)
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=production
# Google Gemini 1.5/2.0 API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Sarvam AI API Key (for Indian multilingual voice & STT)
SARVAM_API_KEY=your_sarvam_api_key_here

# NestJS base URL for webhooks and synchronization
NESTJS_BASE_URL=http://localhost:3000
